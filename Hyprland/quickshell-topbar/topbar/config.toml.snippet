# Adicione este bloco ao seu ~/.config/matugen/config.toml
#
# Copie quickshell-colors.json para ~/.config/matugen/templates/
# e o matugen atualizará o accent da barra em tempo real.

[templates.quickshell]
input_path = '~/.config/matugen/templates/quickshell-colors.json'
output_path = '~/.cache/quickshell/colors.json'
